#!/bin/sh
# commit-msg: the subject must be a conventional commit (`fix(scope): ...`) or
# ticket-first (`OG-4703: ...`). POSIX sh + grep -E only, so it runs anywhere git
# does, Git for Windows included.
#
# Lives only in clawd-harness; nothing is copied into work repos. Each
# repo points here with local, untracked config (harness.sh <dir> does it):
#   git config core.hooksPath ~/dev/personal/clawd-harness/global/githooks

subject=$(grep -v '^#' "$1" | sed -n '/[^[:space:]]/{p;q;}')

# Messages git writes itself.
case "$subject" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

# Subject only: a second non-empty line is a body or a trailer.
lines=$(sed '/^# -* >8 -*$/,$d' "$1" | grep -v '^#' | grep -c '[^[:space:]]')
if [ "$lines" -gt 1 ]; then
    echo "ERROR: Commit message must be the subject line only." >&2
    exit 1
fi

conventional='^(feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert)(\([^)]+\))?!?: .+'
ticket='^[A-Z][A-Z0-9]{1,9}-[0-9]+(\([^)]+\))?!?: .+'

printf '%s\n' "$subject" | grep -Eq "$conventional|$ticket" && exit 0

cat >&2 <<EOF
ERROR: Commit message follows neither accepted format.

Conventional: <type>(<scope>): <description>
Types:        feat | fix | chore | docs | style | refactor | perf | test | build | ci | revert
Ticket:       <TEAM>-<number>: <description>   e.g. OG-4703: Play Golf - GHIN

Got: "$subject"
EOF
exit 1
