#!/bin/sh
# On `git worktree add`, symlink the untracked Claude harness (CLAUDE.md, .claude/,
# docs/brain) and the ignored env files (.env, .env.local, apps/api/.env, ...) from the
# main checkout, so every worktree shares one copy and its app can start.
# Git passes an all-zero previous ref only when a worktree is created.
[ "$1" = "0000000000000000000000000000000000000000" ] || exit 0

main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
here=$(git rev-parse --show-toplevel)
[ "$main" = "$here" ] && exit 0

git -C "$main" ls-files --others --ignored --exclude-standard --directory |
  sed 's#/$##' | grep -E '(^|/)(CLAUDE\.md|\.claude|docs/brain|\.env(\.[^/]+)?)$' |
  grep -v '\.env\.worktree$' |
  while read -r p; do
    [ -e "$here/$p" ] || [ -L "$here/$p" ] && continue
    mkdir -p "$(dirname "$here/$p")"
    ln -s "$main/$p" "$here/$p"
  done

# Per-worktree runtime: a slot, free ports and a compose project of its own, so
# 2-3 Story stacks run side by side (full mode). The project reads them with
# defaults, e.g. "${WT_DB_PORT:-5432}:5432", and the main checkout keeps its ports.
# Ports are checked against the whole machine, not only other worktrees: work
# projects already hold some (a Postgres on 5433, Redis on 6379).
[ -e "$here/.env.worktree" ] && exit 0
[ -n "$(git branch --show-current)" ] || exit 0   # detached scratch worktrees (spec-verify) need no runtime
exclude="$(git rev-parse --path-format=absolute --git-common-dir)/info/exclude"
mkdir -p "$(dirname "$exclude")"
grep -qxF '.env.worktree' "$exclude" 2>/dev/null || echo '.env.worktree' >> "$exclude"

used=$(git worktree list --porcelain | sed -n 's/^worktree //p' |
  while read -r wt; do sed -n 's/^WT_SLOT=//p' "$wt/.env.worktree" 2>/dev/null; done)
busy() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }

slot=1
while [ "$slot" -le 20 ]; do
  db=$((15432 + slot)); api=$((18000 + slot)); web=$((13000 + slot))
  if ! echo "$used" | grep -qx "$slot" && ! busy "$db" && ! busy "$api" && ! busy "$web"; then
    name=$(printf '%s-%s' "$(basename "$main")" "$(git branch --show-current)" |
      tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_\n-' '-')
    cat > "$here/.env.worktree" <<EOF
# Generated by clawd-harness post-checkout. Load before starting the stack:
#   set -a; . ./.env.worktree; set +a
COMPOSE_PROJECT_NAME=$name
WT_SLOT=$slot
WT_DB_PORT=$db
WT_API_PORT=$api
WT_WEB_PORT=$web
EOF
    exit 0
  fi
  slot=$((slot + 1))
done
echo "post-checkout: no free worktree slot (1-20), .env.worktree not written" >&2
exit 0
